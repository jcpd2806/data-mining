   "source": [
    "# Startup de Logística: Baja California\n",
    "Resolución de misiones operativas y estratégicas mediante algoritmos de clusterización."
   ],
   "id": "ed3e2a24a2ca6327"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Fase 1: Exploración Inicial"
   ],
   "id": "34680519a6ee6cde"
  },
  {
   "cell_type": "code",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-11-08T20:19:19.369499Z",
     "start_time": "2026-11-08T20:19:19.279346Z"
    }
   },
   "source": [
    "import os\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "\n",
    "\n",
    "csv_path = os.path.join(\"data\", \"logistica_baja_california.csv\")\n",
    "df = pd.read_csv(csv_path)\n",
    "\n",
    "# Caracteristicas necesarias en (X)\n",
    "X = df[['Longitud', 'Latitud']]\n",
    "\n",
    "# Escalar los datos\n",
    "scaler = StandardScaler()\n",
    "X_scaled = scaler.fit_transform(X)\n",
    "\n",
    "# Datos Crudos\n",
    "plt.figure(figsize=(8, 10))\n",
    "plt.scatter(df['Longitud'], df['Latitud'], alpha=0.5, s=10, c='blue')\n",
    "plt.title('Dispersión de Solicitudes (Fase 1)')\n",
    "plt.xlabel('Longitud')\n",
    "plt.ylabel('Latitud')\n",
    "plt.grid(True)\n",
    "plt.show()"
   ],
   "id": "96c6d205af0b0f48",
   "outputs": [
    {
     "data": {
      "text/plain": [
       "<Figure size 800x1000 with 1 Axes>"
      ],
      "image/png": ""
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "execution_count": 6
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Fase 2: Misión Estratégica (Ubicación de 3 Cedis)"
   ],
   "id": "e0f0ddccaf7a90be"
  },
  {
   "cell_type": "code",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-11-08T20:18:09.826644Z",
     "start_time": "2026-11-08T20:18:09.462125Z"
    }
   },
   "source": [
    "from sklearn.cluster import KMeans\n",
    "\n",
    "# Utilizamos KMeans\n",
    "kmeans = KMeans(n_clusters=3, random_state=42)\n",
    "kmeans_labels = kmeans.fit_predict(X_scaled)\n",
    "\n",
    "centros_scaled = kmeans.cluster_centers_\n",
    "centros_reales = scaler.inverse_transform(centros_scaled)\n",
    "\n",
    "print(\"Coordenadas de los Cedis (K-Means):\")\n",
    "for i, c in enumerate(centros_reales):\n",
    "    print(f\"Cedi {i+1}: Latitud {c[1]:.4f}, Longitud {c[0]:.4f}\")\n",
    "\n",
    "plt.figure(figsize=(8, 10))\n",
    "plt.scatter(df['Longitud'], df['Latitud'], c=kmeans_labels, cmap='viridis', alpha=0.5, s=10)\n",
    "plt.scatter(centros_reales[:, 0], centros_reales[:, 1], c='red', marker='X', s=200, label='Cedis')\n",
    "plt.title('Ubicación Estratégica de Cedis (K-Means)')\n",
    "plt.xlabel('Longitud')\n",
    "plt.ylabel('Latitud')\n",
    "plt.legend()\n",
    "plt.grid(True)\n",
    "plt.show()"
   ],
   "id": "9d1fc279fd768ab5",
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
